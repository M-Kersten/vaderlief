# EmailJS-sleutels — kopieer dit bestand naar .env en vul je eigen waarden in.
# Maak een gratis account op https://www.emailjs.com/
#
# In de EmailJS-template gebruik je de variabelen {{cadeau}}, {{datum}} en
# {{bericht}} (en eventueel {{datum_iso}}).
# Zet als ontvanger jouw eigen e-mailadres, dan krijg je het verzoek binnen.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
